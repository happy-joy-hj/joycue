# Pooled Neon connection for the Next.js runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=verify-full"

# Direct Neon connection for Prisma migrations and administrative tasks
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-high-entropy-secret-at-least-32-characters"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
